# SplitShare Environment Configuration

# Firebase Configuration (for Google Sign-In, Email Verification & Firestore)
# Get these from Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Backend API URL (for local network mobile APK testing, default auto-detected)
# VITE_API_BASE_URL=http://192.168.1.34:3001
