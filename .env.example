# SplitShare Environment Configuration

# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# -------------------------------------------------------------
# Create a free M0 cluster on https://cloud.mongodb.com/
# Example: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/splitshare?retryWrites=true&w=majority
# (If left blank, the backend automatically uses local database.json)
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxx.mongodb.net/splitshare?retryWrites=true&w=majority

# -------------------------------------------------------------
# 2. SERVER & SECURITY
# -------------------------------------------------------------
PORT=3001
JWT_SECRET=super-secure-jwt-secret-replace-in-production

# -------------------------------------------------------------
# 3. FIREBASE AUTH CONFIGURATION
# -------------------------------------------------------------
# Get these keys from Firebase Console: https://console.firebase.google.com/
# Go to: Project Settings > General > Your Apps > Web App (</>)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# -------------------------------------------------------------
# 4. FRONTEND API BASE URL
# -------------------------------------------------------------
# For local browser testing on PC: leave empty (Vite dev server proxies /api to http://localhost:3001)
# For local mobile APK testing on same Wi-Fi: http://<YOUR_PC_LOCAL_IP>:3001
# For production cloud deployment (e.g. Render / Railway): https://your-splitshare-api.onrender.com
# VITE_API_BASE_URL=https://your-splitshare-api.onrender.com
